{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "oba-cardapio-gestao",

  "main": "src/index.js",

  "compatibility_date": "2026-08-29",

  "workers_dev": true,

  "preview_urls": false,

    "secrets": {
    "required": [
      "AUTH_PASSWORD",
      "AUTH_SESSION_SECRET"
    ]
  },
"assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "oba-cardapio-gestao",

  "main": "src/index.js",

  "compatibility_date": "2026-08-29",

  "workers_dev": false,

  "preview_urls": false,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
